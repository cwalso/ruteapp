{
  "name": "ruteapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "routing:fetch": "node --experimental-strip-types scripts/routing/fetchOsm.ts nerskogen",
    "routing:build": "node --experimental-strip-types scripts/routing/buildDataset.ts nerskogen",
    "routing:verify": "vitest run tests/routing/nerskogenDataset.test.ts --reporter=verbose --disableConsoleIntercept",
    "routing:conflation-spike": "node scripts/routing/diagnostics/runFkbConflationSpike.mjs",
    "routing:fkb-candidates": "node scripts/routing/diagnostics/runFkbValidationCandidates.mjs",
    "routing:fkb-validation": "node scripts/routing/diagnostics/runFkbValidationSpike.mjs",
    "routing:same-component-candidates": "node scripts/routing/diagnostics/runSameComponentShortcutCandidates.mjs",
    "routing:virtual-candidates": "node scripts/routing/diagnostics/runVirtualConnectionCandidates.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "maplibre-gl": "^6.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
